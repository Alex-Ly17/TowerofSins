<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/User%20Interface/Assets/GameUIStyle.uss?fileID=7433441132597879392&amp;guid=b7795ecacd9e7fe4796f7e37dd58995a&amp;type=3#GameUIStyle"/>
    <ui:VisualElement name="HealthBarBackground" class="healthbar-size" style="flex-grow: 1; position: absolute; height: 75px; background-image: url(&quot;project://database/Assets/User%20Interface/Assets/HealthbarBackground.png?fileID=2800000&amp;guid=e7fb58ea559217e4b9d62882222abf7b&amp;type=3#HealthbarBackground&quot;);">
        <ui:VisualElement name="HealthBarMask" style="flex-grow: 1; position: absolute; width: 88%; height: 100%; overflow: hidden; transition-property: width; transition-duration: 0.5s; transition-timing-function: ease-out-bounce;">
            <ui:VisualElement name="HealthBarFill" class="healthbar-size" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/User%20Interface/Assets/HealthBarFill.png?fileID=2800000&amp;guid=1c2cbcff4b9563345b3f0e3c367b263c&amp;type=3#HealthBarFill&quot;); position: absolute; height: 100%; overflow: visible;"/>
        </ui:VisualElement>
        <ui:Label text="Label" name="HealthLabel" style="position: absolute; width: 100%; height: 100%; font-size: 16px; -unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 50px;"/>
    </ui:VisualElement>
</ui:UXML>
